<view class="page">
  <view class="section">
    <view class="title">双人房间</view>
    <input class="input" value="{{roomName}}" bindinput="onRoomName" placeholder="房间名称" />
  </view>
  <view class="section">
    <button class="button button-primary" bindtap="createRoom">创建房间</button>
  </view>

  <view class="section">
    <view class="subtitle">我的房间</view>
    <block wx:for="{{rooms}}" wx:key="id">
      <view class="event-card">
        <view class="event-title">{{item.name}}</view>
        <view class="event-summary">邀请码：{{item.invite_code}}</view>
        <view class="meta">{{item.room_type}} · {{item.member_ids.length}} 人</view>
      </view>
    </block>
  </view>
</view>

