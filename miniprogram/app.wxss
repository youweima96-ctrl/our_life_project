page {
  background: #f6f7f9;
  color: #101828;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e4e7ec;
  border-radius: 12rpx;
  padding: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #667085;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.button {
  min-height: 84rpx;
  line-height: 84rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  margin: 0;
}

.button-primary {
  background: #1f6feb;
  color: #ffffff;
}

.button-secondary {
  background: #ffffff;
  color: #344054;
  border: 1rpx solid #d0d5dd;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 14rpx 18rpx;
  background: #eef4ff;
  color: #175cd3;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.event-card {
  background: #ffffff;
  border: 1rpx solid #e4e7ec;
  border-radius: 12rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.event-title {
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}

.event-summary {
  font-size: 26rpx;
  color: #475467;
  line-height: 1.55;
}

.meta {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
}

